# ==============================================================================
# Portfolio QA Automation - Environment Configuration
# ==============================================================================

# Resend API Key for automated contact form delivery
# Obtain your free API key at: https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Optional: Verified sender email address in Resend
# Default free test domain: "Portfolio Contact <onboarding@resend.dev>"
# Once you verify your domain: "Etienne Poutchoko <contact@yourdomain.com>"
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Recipient email where contact submissions are received
CONTACT_EMAIL_TO=poutchokoetienne@gmail.com
